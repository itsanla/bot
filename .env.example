# Database
DB_PATH=./data/bot.db

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ActiveCollab Service
ACTIVECOLLAB_URL=https://collab.javan.co.id
ACTIVECOLLAB_TOKEN=your_activecollab_token_here
ACTIVECOLLAB_POLL_INTERVAL=30s

# Quiet Hours (Polling paused from 23:00 to 06:00 WIB)
QUIET_HOURS_START=23
QUIET_HOURS_END=6
TIMEZONE=Asia/Jakarta
